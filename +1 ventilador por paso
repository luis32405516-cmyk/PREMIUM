local function CreateToggleButton(text, defaultState, callback)
    local btn = Instance.new("TextButton", Container)
    btn.Size = UDim2.new(0.95, 0, 0, 26)
    btn.BackgroundColor3 = defaultState and Color3.fromRGB(0, 100, 50) or Color3.fromRGB(30, 30, 30)
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 10
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    
    local bStroke = Instance.new("UIStroke", btn)
    bStroke.Thickness = 1
    bStroke.Transparency = 0.6
    bStroke.Color = MainStroke.Color

    btn.MouseButton1Click:Connect(function()
        callback()
        bStroke.Color = MainStroke.Color
    end)
    return btn
end

local function LoadAutoTab()
    ClearContainer()

    local rebirthBtn
    rebirthBtn = CreateToggleButton("🔄 AUTO REBIRT: "..(autoRebirth and "ON" or "OFF"), autoRebirth, function()
        autoRebirth = not autoRebirth
        rebirthBtn.Text = "🔄 AUTO REBIRT: "..(autoRebirth and "ON" or "OFF")
        rebirthBtn.BackgroundColor3 = autoRebirth and Color3.fromRGB(0, 100, 50) or Color3.fromRGB(30, 30, 30)
        
        if autoRebirth then
            Notify("AUTO REBIRT Activado", Color3.fromRGB(0, 255, 0))
            task.spawn(function()
                while autoRebirth do
                    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("DoRebirth")
