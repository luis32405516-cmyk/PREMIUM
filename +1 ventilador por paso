        farmBtn.BackgroundColor3 = autoFarm and Color3.fromRGB(0, 100, 50) or Color3.fromRGB(30, 30, 30)
        
        if autoFarm then
            Notify("FARMEAR Activado", Color3.fromRGB(0, 255, 0))
            task.spawn(function()
                while autoFarm do
                    local char = LP.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = farmCFrame
                    end
                    task.wait(0.5)
                end
            end)
        else
            Notify("FARMEAR Desactivado", Color3.fromRGB(255, 0, 0))
        end
    end)
end

local function LoadWinPadsTab()
    ClearContainer()

    for idx, padInfo in ipairs(winPads) do
        local isState = (activeWinTpIndex == idx)
        local btnText = "🏆 [" .. padInfo.level .. " Lvl] " .. padInfo.name .. ": " .. (isState and "ON" or "OFF")
        
        local winBtn
        winBtn = CreateToggleButton(btnText, isState, function()
            if activeWinTpIndex == idx then
                activeWinTpIndex = nil
                Notify("TP WinPad Desactivado", Color3.fromRGB(255, 0, 0))
            else
                activeWinTpIndex = idx
                Notify("TP " .. padInfo.name .. " Activado", Color3.fromRGB(0, 255, 255))
            end
            
            LoadWinPadsTab()
        end)
    end
end

task.spawn(function()
    while true do
        task.wait(0)
        if activeWinTpIndex then
            local padInfo = winPads[activeWinTpIndex]
            if padInfo then
                local targetPart = GetObjectFromPath(padInfo.path)
                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp and targetPart then
                    hrp.CFrame = targetPart.CFrame
                end
            end
        end
    end
end)

local function LoadAntiLagTab()
    ClearContainer()

    local afkBtn
    afkBtn = CreateToggleButton("🛡️ Anti AFK: "..(antiAfk and "ON" or "OFF"), antiAfk, function()
        antiAfk = not antiAfk
        afkBtn.Text = "🛡️ Anti AFK: "..(antiAfk and "ON" or "OFF")
        afkBtn.BackgroundColor3 = antiAfk and Color3.fromRGB(0, 100, 50) or Color3.fromRGB(30, 30, 30)
        
        if antiAfk then
            Notify("Anti AFK Activado", Color3.fromRGB(0, 255, 100))
            if getconnections then
                for _, c in pairs(getconnections(LP.Idled)) do
                    pcall(function() c:Disable() end)
                    pcall(function() c:Disconnect() end)
                end
            end

            if antiAfkCon then
                antiAfkCon:Disconnect()
                antiAfkCon = nil
            end

            antiAfkCon = LP.Idled:Connect(function()
                if antiAfk then
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.zero)
                end
            end)
        else
            if antiAfkCon then
                antiAfkCon:Disconnect()
                antiAfkCon = nil
            end
            Notify("Anti AFK Desactivado", Color3.fromRGB(255, 0, 0))
        end
    end)

    local pausedBtn
    pausedBtn = CreateToggleButton("🚫 Anti Gameplay Paused: "..(antigameplaypaused and "ON" or "OFF"), antigameplaypaused, function()
        antigameplaypaused = not antigameplaypaused
        pausedBtn.Text = "🚫 Anti Gameplay Paused: "..(antigameplaypaused and "ON" or "OFF")
        pausedBtn.BackgroundColor3 = antigameplaypaused and Color3.fromRGB(0, 100, 50) or Color3.fromRGB(30, 30, 30)
        
        if antigameplaypaused then
            Notify("Anti Gameplay Paused Activado", Color3.fromRGB(0, 255, 150))
            local robloxGui = GuiService.Parent:FindFirstChild("RobloxGui") or game:GetService("CoreGui"):FindFirstChild("RobloxGui")
            
            if robloxGui then
                local existingPause = robloxGui:FindFirstChild("CoreScripts/NetworkPause")
                if existingPause then
                    pcall(function() existingPause:Destroy() end)
                end

                if networkPausedCon then
                    networkPausedCon:Disconnect()
                    networkPausedCon = nil
                end

                networkPausedCon = robloxGui.ChildAdded:Connect(function(obj)
                    if antigameplaypaused and obj.Name == "CoreScripts/NetworkPause" then
                        pcall(function() obj:Destroy() end)
                    end
                end)
            end
        else
            if networkPausedCon then
                networkPausedCon:Disconnect()
                networkPausedCon = nil
            end
            Notify("Anti Gameplay Paused Desactivado", Color3.fromRGB(255, 0, 0))
        end
    end)

    local lagBtn
    lagBtn = CreateToggleButton("🚀 Booster Anti Lag: "..(antiLag and "ON" or "OFF"), antiLag, function()
        antiLag = not antiLag
        lagBtn.Text = "🚀 Booster Anti Lag: "..(antiLag and "ON" or "OFF")
        lagBtn.BackgroundColor3 = antiLag and Color3.fromRGB(0, 100, 50) or Color3.fromRGB(30, 30, 30)
        
        if antiLag then
            Notify("Optimizando Gráficos...", Color3.fromRGB(255, 255, 0))
            
            local Terrain = Workspace:FindFirstChildWhichIsA("Terrain")
            if Terrain then
                Terrain.WaterWaveSize = 0
                Terrain.WaterWaveSpeed = 0
                Terrain.WaterReflectance = 0
                Terrain.WaterTransparency = 1
            end
            
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            Lighting.FogStart = 9e9
            settings().Rendering.QualityLevel = 1
            
            for _, v in pairs(game:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CastShadow = false
                    v.Material = Enum.Material.Plastic
                    v.Reflectance = 0
                    v.BackSurface = Enum.SurfaceType.SmoothNoOutlines
                    v.BottomSurface = Enum.SurfaceType.SmoothNoOutlines
                    v.FrontSurface = Enum.SurfaceType.SmoothNoOutlines
                    v.LeftSurface = Enum.SurfaceType.SmoothNoOutlines
                    v.RightSurface = Enum.SurfaceType.SmoothNoOutlines
                    v.TopSurface = Enum.SurfaceType.SmoothNoOutlines
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v.Transparency = 1
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                    v.Enabled = false
                end
            end

            for _, v in pairs(Lighting:GetDescendants()) do
                if v:IsA("PostEffect") then
                    v.Enabled = false
                end
            end

            if antiLagCon then
                antiLagCon:Disconnect()
                antiLagCon = nil
            end

            antiLagCon = Workspace.DescendantAdded:Connect(function(child)
                if antiLag then
                    task.spawn(function()
                        if child:IsA("ForceField") or child:IsA("Sparkles") or child:IsA("Smoke") or child:IsA("Fire") or child:IsA("Beam") then
                            RunService.Heartbeat:Wait()
                            pcall(function() child:Destroy() end)
                        elseif child:IsA("BasePart") then
                            child.CastShadow = false
                        end
                    end)
                end
            end)

            Notify("Anti Lag Activado", Color3.fromRGB(0, 255, 0))
        else
            if antiLagCon then
                antiLagCon:Disconnect()
                antiLagCon = nil
            end
            
            settings().Rendering.QualityLevel = 0
            Lighting.GlobalShadows = true
            
            for _, v in pairs(game:GetDescendants()) do
                if v:IsA("Decal") or v:IsA("Texture") then
                    v.Transparency = 0
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                    v.Enabled = true
                elseif v:IsA("PostEffect") then
                    v.Enabled = true
                end
            end

            Notify("Gráficos Restaurados", Color3.fromRGB(0, 255, 255))
        end
    end)

    local blackBtn
    blackBtn = CreateToggleButton("⚫ Pantalla Negra (FPS+): "..(blackScreen and "ON" or "OFF"), blackScreen, function()
        blackScreen = not blackScreen
        blackBtn.Text = "⚫ Pantalla Negra (FPS+): "..(blackScreen and "ON" or "OFF")
        blackBtn.BackgroundColor3 = blackScreen and Color3.fromRGB(0, 100, 50) or Color3.fromRGB(30, 30, 30)
        
        if blackScreen then
            RunService:Set3dRenderingEnabled(false)
            
            if not BlackOverlayGui then
                BlackOverlayGui = Instance.new("ScreenGui")
                BlackOverlayGui.Name = "Luis_BlackOverlay_System"
                BlackOverlayGui.DisplayOrder = -100
                BlackOverlayGui.IgnoreGuiInset = true
                BlackOverlayGui.Parent = game:GetService("CoreGui")

                local blackFrame = Instance.new("Frame", BlackOverlayGui)
                blackFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                blackFrame.Size = UDim2.new(1, 0, 1, 0)
                blackFrame.Position = UDim2.new(0, 0, 0, 0)
                blackFrame.Active = false
            else
                BlackOverlayGui.Enabled = true
            end

            Notify("Modo Ahorro de FPS Activado (Negro)", Color3.fromRGB(255, 0, 255))
        else
            RunService:Set3dRenderingEnabled(true)
            
            if BlackOverlayGui then
                BlackOverlayGui.Enabled = false
            end

            Notify("Renderizado 3D Restaurado", Color3.fromRGB(0, 255, 255))
        end
    end)
end

