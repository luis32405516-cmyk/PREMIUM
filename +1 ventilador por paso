                        remote:FireServer()
                    end
                    task.wait(1.5)
                end
            end)
        else
            Notify("AUTO REBIRT Desactivado", Color3.fromRGB(255, 0, 0))
        end
    end)

    local farmBtn
    farmBtn = CreateToggleButton("🏃 FARMEAR: "..(autoFarm and "ON" or "OFF"), autoFarm, function()
        autoFarm = not autoFarm
