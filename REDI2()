-- Cargar la librería HUD
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/luis32405516-cmyk/PREMIUM/refs/heads/main/REDI2"))() -- O requerirla localmente

-- Crear la ventana principal
local Window = Library:CreateWindow({
    Title = "AURA PINK - MULTI MAP HUB",
    ThemeColor = Color3.fromRGB(168, 85, 247) -- Color púrpura Neón (lo puedes cambiar)
})

-- ==========================================
-- MAPA / MUNDO 1
-- ==========================================
local Mundo1 = Window:CreateTab("Mundo 1")

Mundo1:AddToggle("Auto Farm Monedas", false, function(state)
    print("Auto Farm Mundo 1:", state)
end)

Mundo1:AddDropdown("Seleccionar Teleport", {"Zona Inicial", "Cueva", "Jefe"}, function(selected)
    print("Teletransportando a:", selected)
end)

Mundo1:AddButton("Comprar Mejoras", function()
    print("Comprando mejoras de Mundo 1...")
end)


-- ==========================================
-- MAPA / MUNDO 2
-- ==========================================
local Mundo2 = Window:CreateTab("Mundo 2")

Mundo2:AddToggle("Auto Farm Mundo 2", false, function(state)
    print("Auto Farm Mundo 2:", state)
end)


-- ==========================================
-- CONFIGURACIÓN / GENERAL
-- ==========================================
local ConfigTab = Window:CreateTab("Configuración")

ConfigTab:AddButton("Destruir GUI", function()
    Window.ScreenGui:Destroy()
end)
