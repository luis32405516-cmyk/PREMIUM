local Library = {}
Library.__index = Library

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local function CreateScreenGui()
    local gui = Instance.new("ScreenGui")
    gui.Name = "CustomHUD_LUISITO"
    gui.ResetOnSpawn = false
    
    local success, res = pcall(function()
        if gethui then
            return gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(gui)
            return CoreGui
        else
            return CoreGui
        end
    end)
    
    if success and res then
        gui.Parent = res
    else
        gui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    end
    
    return gui
end

function Library:Notify(text, color)
    local ScreenGui = CoreGui:FindFirstChild("Luis_Notify_System")
    if not ScreenGui then
        ScreenGui = Instance.new("ScreenGui")
        ScreenGui.Name = "Luis_Notify_System"
        ScreenGui.Parent = CoreGui
    end

    local n = Instance.new("Frame", ScreenGui)
    n.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    n.Position = UDim2.new(1, 0, 1, -60)
    n.Size = UDim2.new(0, 180, 0, 35)
    Instance.new("UICorner", n).CornerRadius = UDim.new(0, 6)
    
    local s = Instance.new("UIStroke", n)
    s.Color = color or Color3.fromRGB(0, 255, 255)
    s.Thickness = 2
    
    local l = Instance.new("TextLabel", n)
    l.Size = UDim2.new(1, 0, 1, 0)
    l.BackgroundTransparency = 1
    l.Text = "⚡ " .. tostring(text)
    l.TextColor3 = Color3.fromRGB(255, 255, 255)
    l.Font = Enum.Font.GothamBold
    l.TextSize = 11
    
    n:TweenPosition(UDim2.new(1, -190, 1, -60), "Out", "Quart", 0.4)
    task.wait(2.5)
    n:TweenPosition(UDim2.new(1, 0, 1, -60), "In", "Quart", 0.4)
    task.wait(0.5)
    n:Destroy()
end

